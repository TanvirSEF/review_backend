# postgres - replace with your own
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/reviewdibo

# only used by docker compose to spin up the db
POSTGRES_USER=reviewdibo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reviewdibo

# generate a random one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-string

CORS_ORIGINS=*

# admin account, seeded once on first startup
ADMIN_EMAIL=admin@reviewdibo.com
ADMIN_PASSWORD=admin
